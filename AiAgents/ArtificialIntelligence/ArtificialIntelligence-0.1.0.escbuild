DESCRIPTION = "Cognitive Reasoning, Neural Search, Decision Trees, and Knowledge Graph Integration";
HOMEPAGE = "https://github.com/OuluBSD/ArtificialIntelligence";
GIT_REPO = "https://github.com/OuluBSD/ArtificialIntelligence.git";
GIT_BRANCH = "main";
UPP_ASSEMBLY = "uppsrc,examples,tests";
DEFAULT_PACKAGE = "uppsrc/AI/Base";

IUSE = [ "blitz", "debug", "gui", "shared" ];
ACCEPTFLAGS = [ "BLITZ", "DEBUG", "GUI", "SHARED", "POSIX", "LINUX", "WIN32" ];

RDEPEND = [
	"DevCpp/BazaarCore",
	"DevUtil/UppBuilder"
];

src_unpack() {
	GitCheckout(GIT_REPO, GIT_BRANCH);
}

src_compile() {
	UppBuild("AI/Base");
	UppBuild("AI/Logic");
	UppBuild("TrustCore");
}
