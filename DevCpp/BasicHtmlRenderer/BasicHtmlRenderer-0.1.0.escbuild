DESCRIPTION = "Lightweight Native HTML/DOM Rendering, Virtual Widgets, and Bridge";
HOMEPAGE = "https://github.com/OuluBSD/BasicHtmlRenderer";
GIT_REPO = "https://github.com/OuluBSD/BasicHtmlRenderer.git";
GIT_BRANCH = "main";
UPP_ASSEMBLY = "uppsrc,reference,tests";
DEFAULT_PACKAGE = "uppsrc/HtmlGui/HtmlGui";

IUSE = [ "blitz", "debug", "gui", "shared" ];
ACCEPTFLAGS = [ "BLITZ", "DEBUG", "GUI", "SHARED", "POSIX", "LINUX", "WIN32" ];

RDEPEND = [
	"DevCpp/BazaarCore",
	"DevUtil/UppBuilder"
];

src_unpack() {
	GitCheckout(GIT_REPO, GIT_BRANCH);
}

src_compile() {
	UppBuild("HtmlGui/HtmlGui");
	UppBuild("HtmlApp01");
}
