DESCRIPTION = "Computer Vision processing, camera calibration, stereo disparity, and feature extraction";
HOMEPAGE = "https://github.com/OuluBSD/ComputerVision";
GIT_REPO = "https://github.com/OuluBSD/ComputerVision.git";
GIT_BRANCH = "main";
UPP_ASSEMBLY = "ComputerVision,StereoCalibrationTool,tests";
DEFAULT_PACKAGE = "tests/CvCheck";

IUSE = [ "blitz", "debug", "gui", "shared" ];
ACCEPTFLAGS = [ "BLITZ", "DEBUG", "GUI", "SHARED", "POSIX", "LINUX", "WIN32" ];

RDEPEND = [
	"DevCpp/BazaarCore",
	"DevCpp/UppGeometry",
	"DevUtil/UppBuilder"
];

src_unpack() {
	GitCheckout(GIT_REPO, GIT_BRANCH);
}

src_compile() {
	UppBuild("ComputerVision");
	UppBuild("tests/CvCheck");
}

src_test() {
	Run("CvCheck");
}
