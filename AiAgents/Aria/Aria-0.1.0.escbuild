DESCRIPTION = "Browser Automation, Stealth CDP/Marionette Scraping, and Aria Ecosystem";
HOMEPAGE = "https://github.com/OuluBSD/Aria";
GIT_REPO = "https://github.com/OuluBSD/Aria.git";
GIT_BRANCH = "main";
UPP_ASSEMBLY = "uppsrc,WebDriver,Aria,AriaCLI,AriaHub,tests";
DEFAULT_PACKAGE = "tests/AriaCheck";

IUSE = [ "blitz", "debug", "gui", "shared" ];
ACCEPTFLAGS = [ "BLITZ", "DEBUG", "GUI", "SHARED", "POSIX", "LINUX", "WIN32" ];

RDEPEND = [
	"DevCpp/BazaarCore",
	"DevUtil/UppBuilder"
];

src_unpack() {
	GitCheckout(GIT_REPO, GIT_BRANCH);
}

src_compile() {
	UppBuild("AriaCLI/AriaCLI");
	UppBuild("tests/AriaCheck");
}

src_test() {
	Run("AriaCheck");
}
