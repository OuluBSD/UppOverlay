DESCRIPTION = "Eon Dataflow, ECS Engine, Node Scripting, and Visual Workbench";
HOMEPAGE = "https://github.com/OuluBSD/Eon";
GIT_REPO = "https://github.com/OuluBSD/Eon.git";
GIT_BRANCH = "main";
UPP_ASSEMBLY = "uppsrc,examples";
DEFAULT_PACKAGE = "examples/EonDemo";

IUSE = [ "blitz", "debug", "gui", "shared" ];
ACCEPTFLAGS = [ "BLITZ", "DEBUG", "GUI", "SHARED", "POSIX", "LINUX", "WIN32" ];

RDEPEND = [
	"DevCpp/BazaarCore",
	"DevCpp/VFS",
	"DevUtil/UppBuilder"
];

src_unpack() {
	GitCheckout(GIT_REPO, GIT_BRANCH);
}

src_compile() {
	UppBuild("Eon/Eon");
	UppBuild("examples/EonDemo");
}

src_test() {
	Run("EonDemo");
}
