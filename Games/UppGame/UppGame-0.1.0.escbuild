DESCRIPTION = "2D/3D Game Engines, Card Games, Adventure Game Runtime, and Games Suite";
HOMEPAGE = "https://github.com/OuluBSD/UppGame";
GIT_REPO = "https://github.com/OuluBSD/UppGame.git";
GIT_BRANCH = "main";
UPP_ASSEMBLY = "uppsrc,game,tests";
DEFAULT_PACKAGE = "tests/GameCheck";

IUSE = [ "blitz", "debug", "gui", "shared" ];
ACCEPTFLAGS = [ "BLITZ", "DEBUG", "GUI", "SHARED", "POSIX", "LINUX", "WIN32" ];

RDEPEND = [
	"DevCpp/BazaarCore",
	"DevCpp/UppGeometry",
	"DevUtil/UppBuilder"
];

src_unpack() {
	GitCheckout(GIT_REPO, GIT_BRANCH);
}

src_compile() {
	UppBuild("GameLib/GameLib");
	UppBuild("tests/GameCheck");
}

src_test() {
	Run("GameCheck");
}
