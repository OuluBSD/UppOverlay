DESCRIPTION = "XR, VR, HMD Tracking, Stereo Vision, and SoftVR Environment";
HOMEPAGE = "https://github.com/OuluBSD/UppXR";
GIT_REPO = "https://github.com/OuluBSD/UppXR.git";
GIT_BRANCH = "main";
UPP_ASSEMBLY = "uppsrc,examples,tests";
DEFAULT_PACKAGE = "uppsrc/XRClient/XRClient";

IUSE = [ "blitz", "debug", "gui", "shared" ];
ACCEPTFLAGS = [ "BLITZ", "DEBUG", "GUI", "SHARED", "POSIX", "LINUX", "WIN32" ];

RDEPEND = [
	"DevCpp/BazaarCore",
	"DevCpp/UppGeometry",
	"MediaGfx/ComputerVision",
	"DevUtil/UppBuilder"
];

src_unpack() {
	GitCheckout(GIT_REPO, GIT_BRANCH);
}

src_compile() {
	UppBuild("XRClient/XRClient");
	UppBuild("SoftVR");
}
