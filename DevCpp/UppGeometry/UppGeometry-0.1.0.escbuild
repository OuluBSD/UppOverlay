DESCRIPTION = "3D Geometry Engine, Vector Math, Spatial Transforms, and Kinematics";
HOMEPAGE = "https://github.com/OuluBSD/UppGeometry";
GIT_REPO = "https://github.com/OuluBSD/UppGeometry.git";
GIT_BRANCH = "main";
UPP_ASSEMBLY = "uppsrc,tests";
DEFAULT_PACKAGE = "uppsrc/Geometry/Geometry";

IUSE = [ "blitz", "debug", "gui", "shared" ];
ACCEPTFLAGS = [ "BLITZ", "DEBUG", "GUI", "SHARED", "POSIX", "LINUX", "WIN32" ];

RDEPEND = [
	"DevCpp/BazaarCore",
	"DevUtil/UppBuilder"
];

src_unpack() {
	GitCheckout(GIT_REPO, GIT_BRANCH);
}

src_compile() {
	UppBuild("Geometry/Geometry");
}
