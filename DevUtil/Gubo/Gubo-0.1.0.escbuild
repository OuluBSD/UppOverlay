DESCRIPTION = "Voxel, Procedural 3D Block Engine, and Embedded OpenGL UI Controls";
HOMEPAGE = "https://github.com/OuluBSD/Gubo";
GIT_REPO = "https://github.com/OuluBSD/Gubo.git";
GIT_BRANCH = "main";
UPP_ASSEMBLY = "uppsrc,tests";
DEFAULT_PACKAGE = "uppsrc/GuboCore/GuboCore";

IUSE = [ "blitz", "debug", "gui", "shared" ];
ACCEPTFLAGS = [ "BLITZ", "DEBUG", "GUI", "SHARED", "POSIX", "LINUX", "WIN32" ];

RDEPEND = [
	"DevCpp/BazaarCore",
	"DevCpp/UppGeometry",
	"DevUtil/UppBuilder"
];

src_unpack() {
	GitCheckout(GIT_REPO, GIT_BRANCH);
}

src_compile() {
	UppBuild("GuboCore/GuboCore");
	UppBuild("GuboCtrl");
	UppBuild("GuboSuite");
}
